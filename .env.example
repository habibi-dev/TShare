# The main application domain used internally by the app.
# This is typically the hostname that clients use to reach your API or frontend.
# Example: myapp.local or api.example.com
APP_DOMAIN=127.0.0.1

# The final, public-facing domain used when generating absolute URLs.
# Useful when you need canonical URLs for redirects, emails, or shared links.
# Example: example.com
APP_FINAL_DOMAIN=127.0.0.1

# The network interface (host) the web server should bind to.
# 127.0.0.1 means only local connections are accepted.
APP_HOST=127.0.0.1

# The port on which the web server listens.
# Example: 8080 for development or 80 for production HTTP.
APP_PORT=8085

# Whether HTTPS should be enabled.
# Set to `true` if you're using TLS/SSL certificates (e.g., via Nginx reverse proxy or Let's Encrypt).
# Set to `false` if running plain HTTP (e.g., local dev).
APP_HTTPS=false

# This is the URL that SQLx will use to make connections to the Postgres database.
DATABASE_URL=sqlite://database.db?mode=rwc

# This is the HMAC key that will be used to sign login tokens (JWTs).
# It just needs to be a random string, preferably at least 48 characters long to provide sufficient
# brute-force resistance.
#
# If you have OpenSSL installed, try `openssl rand -base64 48`
#
# Or, just search Google for a secure password generator.
HMAC_KEY={random-string}

# Base folder for writing application logs.
LOG_DIRECTORY=logs

# Retention window for keeping archived log files (in days).
LOG_RETENTION_DAYS=3

# Redis connection URL for ephemeral share storage.
REDIS_URL=redis://127.0.0.1/

# --- File upload (optional) ---
# Enable file attachments on shares.
FILE_UPLOAD_ENABLED=true

# Maximum upload size in megabytes.
FILE_MAX_SIZE_MB=10

# Public base URL for direct downloads (trailing slash recommended). Used when FILE_DOWNLOAD_MODE=direct.
FILE_PUBLIC_BASE_URL=

# Download mode: direct (CDN/public URL) or proxy (through this app at /c/{id}/file).
FILE_DOWNLOAD_MODE=direct

# Comma-separated allowed extensions without dots. Empty disables upload even if FILE_UPLOAD_ENABLED=true.
FILE_ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,webp,zip,doc,docx,xls,xlsx,csv,json,md

# Storage backend: local or ftp
FILE_STORAGE_PROTOCOL=local

# Local disk directory when FILE_STORAGE_PROTOCOL=local
FILE_STORAGE_LOCAL_ROOT=uploads

# FTP settings when FILE_STORAGE_PROTOCOL=ftp
FILE_STORAGE_HOST=
FILE_STORAGE_PORT=21
FILE_STORAGE_USERNAME=
FILE_STORAGE_PASSWORD=
FILE_STORAGE_BASE_PATH=/uploads/
FILE_STORAGE_USE_TLS=false

# How often to purge expired files from storage (seconds).
FILE_CLEANUP_INTERVAL_SECS=60
